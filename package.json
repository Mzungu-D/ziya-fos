{
  "name": "ziya-fos",
  "private": true,
  "version": "1.0.0",
  "description": "Ziya Financial Operating System",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch server/server.ts\"",
    "server": "tsx watch server/server.ts",
    "start": "prisma generate && prisma migrate deploy && tsx server/server.ts",
    "build": "prisma generate && tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "preview": "vite preview",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "@aws-sdk/s3-request-presigner": "^3.1114.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/vite": "^4.3.2",
    "axios": "1.18.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.23.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "prisma": "^6.19.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "7.18.2",
    "recharts": "^3.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "10.5.4",
    "concurrently": "^9.1.2",
    "oxlint": "^1.71.0",
    "postcss": "8.5.26",
    "tailwindcss": "^4.3.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
