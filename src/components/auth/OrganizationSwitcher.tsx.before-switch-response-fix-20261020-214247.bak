import { useEffect, useMemo, useState } from "react";

import {
  Check,
  ChevronDown,
  Building2,
  Loader2,
} from "lucide-react";

import {
  authenticatedFetch,
  updateTenantSession,
} from "../../lib/auth";

interface Organization {
  id: string;
  name: string;
  legalName?: string | null;
  logoUrl?: string | null;
  isCurrent: boolean;
}

interface OrganizationsResponse {
  success: boolean;
  organizations?: Organization[];
  message?: string;
}

interface SwitchResponse {
  success: boolean;
  token?: string;
  organization?: Organization;
  message?: string;
}

function getInitials(name: string): string {
  const value = name.trim();

  if (!value) {
    return "?";
  }

  return value
    .split(/\s+/)
    .slice(0, 2)
    .map((part) => part.charAt(0).toUpperCase())
    .join("");
}

export default function OrganizationSwitcher() {
  const [organizations, setOrganizations] =
    useState<Organization[]>([]);

  const [currentId, setCurrentId] =
    useState("");

  const [switching, setSwitching] =
    useState(false);

  const [open, setOpen] =
    useState(false);

  const [error, setError] =
    useState("");

  useEffect(() => {
    let cancelled = false;

    async function loadOrganizations() {
      try {
        setError("");

        const response =
          await authenticatedFetch(
            "/api/organizations",
          );

        const data =
          (await response.json()) as OrganizationsResponse;

        if (
          cancelled ||
          !response.ok ||
          !data.success
        ) {
          return;
        }

        const available =
          data.organizations ?? [];

        setOrganizations(available);

        setCurrentId(
          available.find(
            (item) => item.isCurrent,
          )?.id ?? "",
        );
      } catch {
        if (!cancelled) {
          /*
           * The selector is an optional workspace
           * convenience feature. The dashboard remains
           * usable when the organization list cannot load.
           */
          setOrganizations([]);
        }
      }
    }

    void loadOrganizations();

    return () => {
      cancelled = true;
    };
  }, []);

  const currentOrganization = useMemo(
    () =>
      organizations.find(
        (organization) =>
          organization.id === currentId,
      ) ?? null,
    [organizations, currentId],
  );

  async function switchOrganization(
    organizationId: string,
  ) {
    if (
      !organizationId ||
      organizationId === currentId ||
      switching
    ) {
      setOpen(false);
      return;
    }

    try {
      setSwitching(true);
      setError("");
      setOpen(false);

      const response =
        await authenticatedFetch(
          "/api/organizations/switch",
          {
            method: "POST",
            headers: {
              "Content-Type":
                "application/json",
            },
            body: JSON.stringify({
              organizationId,
            }),
          },
        );

      const data =
        (await response.json()) as SwitchResponse;

      if (
        !response.ok ||
        !data.success ||
        !data.token ||
        !data.organization
      ) {
        throw new Error(
          data.message ||
            "Unable to switch organization.",
        );
      }

      /*
       * The backend returns the new tenant session.
       *
       * Update the authenticated tenant context before
       * reloading the workspace so all tenant-scoped
       * pages start from the newly selected organization.
       */

      updateTenantSession(
        data.token,
        {
          ...data.organization,
          role: data.membership?.role,
          permissions: data.membership?.permissions,
        },
      );

      window.location.assign(
        "/dashboard",
      );
    } catch (switchError) {
      setError(
        switchError instanceof Error
          ? switchError.message
          : "Unable to switch organization.",
      );
    } finally {
      setSwitching(false);
    }
  }

  /*
   * Don't render the selector when the user belongs
   * to only one organization.
   */

  if (organizations.length < 2) {
    return null;
  }

  const organizationName =
    currentOrganization?.name ||
    "Workspace";

  return (
    <div className="relative mb-5 w-full">
      {/* ===================================================
          WORKSPACE SELECTOR
      =================================================== */}

      <button
        type="button"
        disabled={switching}
        onClick={() =>
          setOpen((value) => !value)
        }
        aria-haspopup="listbox"
        aria-expanded={open}
        className="flex w-full items-center gap-3 rounded-2xl border border-[#E6E8F0] bg-white px-3 py-3 text-left shadow-sm transition hover:border-[#D7DAE5] hover:shadow-md disabled:cursor-wait disabled:opacity-70"
      >
        {/* Organization logo */}

        <div className="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-[#E6E8F0] bg-[#F8F9FC]">
          {currentOrganization?.logoUrl ? (
            <img
              src={
                currentOrganization.logoUrl
              }
              alt={`${organizationName} logo`}
              className="h-full w-full object-contain p-1.5"
            />
          ) : (
            <div className="flex h-full w-full items-center justify-center bg-[#D4AF37] text-xs font-bold text-[#20243A]">
              {getInitials(
                organizationName,
              )}
            </div>
          )}
        </div>

        {/* Organization information */}

        <div className="min-w-0 flex-1">
          <p className="text-[10px] font-semibold uppercase tracking-wider text-[#8A8FA5]">
            Workspace
          </p>

          <p className="mt-0.5 truncate text-sm font-semibold text-[#20243A]">
            {organizationName}
          </p>
        </div>

        {/* Selector indicator */}

        {switching ? (
          <Loader2
            size={17}
            className="shrink-0 animate-spin text-[#666B84]"
            aria-hidden="true"
          />
        ) : (
          <ChevronDown
            size={17}
            className={`shrink-0 text-[#666B84] transition-transform ${
              open
                ? "rotate-180"
                : ""
            }`}
            aria-hidden="true"
          />
        )}
      </button>

      {/* ===================================================
          WORKSPACE MENU
      =================================================== */}

      {open && (
        <>
          {/* Mobile backdrop */}

          <button
            type="button"
            aria-label="Close workspace selector"
            className="fixed inset-0 z-40 cursor-default bg-transparent md:hidden"
            onClick={() =>
              setOpen(false)
            }
          />

          <div
            role="listbox"
            aria-label="Select workspace"
            className="absolute left-0 right-0 top-[calc(100%+8px)] z-50 overflow-hidden rounded-2xl border border-[#E6E8F0] bg-white p-2 shadow-[0_18px_50px_rgba(15,23,42,0.14)]"
          >
            <div className="px-3 pb-2 pt-2">
              <p className="text-[10px] font-semibold uppercase tracking-wider text-[#8A8FA5]">
                Switch workspace
              </p>
            </div>

            <div className="max-h-72 overflow-y-auto">
              {organizations.map(
                (organization) => {
                  const isCurrent =
                    organization.id ===
                    currentId;

                  return (
                    <button
                      key={
                        organization.id
                      }
                      type="button"
                      role="option"
                      aria-selected={
                        isCurrent
                      }
                      disabled={
                        switching
                      }
                      onClick={() =>
                        void switchOrganization(
                          organization.id,
                        )
                      }
                      className={`flex w-full items-center gap-3 rounded-xl px-3 py-3 text-left transition ${
                        isCurrent
                          ? "bg-[#F5F6F9]"
                          : "hover:bg-[#F8F9FC]"
                      }`}
                    >
                      <div className="flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-[#E6E8F0] bg-white">
                        {organization.logoUrl ? (
                          <img
                            src={
                              organization.logoUrl
                            }
                            alt=""
                            className="h-full w-full object-contain p-1"
                          />
                        ) : (
                          <div className="flex h-full w-full items-center justify-center bg-[#D4AF37] text-[11px] font-bold text-[#20243A]">
                            {getInitials(
                              organization.name,
                            )}
                          </div>
                        )}
                      </div>

                      <div className="min-w-0 flex-1">
                        <p className="truncate text-sm font-semibold text-[#20243A]">
                          {organization.name}
                        </p>

                        {organization.legalName &&
                          organization.legalName !==
                            organization.name && (
                            <p className="mt-0.5 truncate text-xs text-[#8A8FA5]">
                              {
                                organization.legalName
                              }
                            </p>
                          )}
                      </div>

                      {isCurrent && (
                        <Check
                          size={17}
                          className="shrink-0 text-[#0D9488]"
                          aria-hidden="true"
                        />
                      )}
                    </button>
                  );
                },
              )}
            </div>

            {/* Workspace context */}

            <div className="mt-2 border-t border-[#ECECF3] px-3 py-2.5">
              <div className="flex items-center gap-2 text-xs text-[#8A8FA5]">
                <Building2
                  size={13}
                  aria-hidden="true"
                />

                <span>
                  Changes apply to the selected workspace.
                </span>
              </div>
            </div>
          </div>
        </>
      )}

      {/* ===================================================
          ERROR
      =================================================== */}

      {error && (
        <p className="mt-2 rounded-lg bg-red-50 px-3 py-2 text-xs font-medium text-red-600">
          {error}
        </p>
      )}
    </div>
  );
}