  status             String       @default("ACTIVE")
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  employee           Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, reference])
  @@index([organizationId])
  @@index([organizationId, employeeId])
  @@index([organizationId, status])
}

model PayrollEarning {
  id              String           @id @default(cuid())
  payrollRecordId String
  organizationId  String
  sourceEarningId String?
  type            String
  description     String?
  amount          Decimal          @db.Decimal(14, 2)
  recurring       Boolean          @default(true)
  taxable         Boolean          @default(true)
  effectiveFrom   DateTime?
  createdAt       DateTime         @default(now())
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollRecord   PayrollRecord    @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  sourceEarning   EmployeeEarning? @relation(fields: [sourceEarningId], references: [id])

  @@index([organizationId])
  @@index([organizationId, payrollRecordId])
  @@index([organizationId, sourceEarningId])
  @@index([payrollRecordId])
}

model PayrollDeduction {
  id              String        @id @default(cuid())
  payrollRecordId String
  organizationId  String
  type            String
  description     String?
  amount          Decimal       @db.Decimal(14, 2)
  createdAt       DateTime      @default(now())
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollRecord   PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, payrollRecordId])
  @@index([organizationId, type])
}

model PayrollEmployerContribution {
  id              String        @id @default(cuid())
  payrollRecordId String
  organizationId  String
  type            String
  description     String?
  amount          Decimal       @db.Decimal(14, 2)
  createdAt       DateTime      @default(now())
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollRecord   PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, payrollRecordId])
  @@index([organizationId, type])
}

model PayrollPeriod {
  id              String          @id @default(cuid())
  name            String
  periodStart     DateTime
  periodEnd       DateTime
  status          String          @default("DRAFT")
  totalGross      Decimal         @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal         @default(0) @db.Decimal(14, 2)
  totalNet        Decimal         @default(0) @db.Decimal(14, 2)
  processedAt     DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  paidAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollRecords  PayrollRecord[]
  taxFilings      TaxFiling[]

  @@unique([organizationId, periodStart, periodEnd])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([periodStart, periodEnd])
}

model PayrollRecord {
  id                    String                        @id @default(cuid())
  payrollPeriodId       String
  employeeId            String
  organizationId        String
  basicSalary           Decimal                       @db.Decimal(14, 2)
  allowances            Decimal                       @default(0) @db.Decimal(14, 2)
  grossSalary           Decimal                       @default(0) @db.Decimal(14, 2)
  deductions            Decimal                       @default(0) @db.Decimal(14, 2)
  netSalary             Decimal                       @default(0) @db.Decimal(14, 2)
  status                String                        @default("PENDING")
  processedAt           DateTime?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  payrollDeductions     PayrollDeduction[]
  payrollEarnings       PayrollEarning[]
  employerContributions PayrollEmployerContribution[]
  employee              Employee                      @relation(fields: [employeeId], references: [id])
  organization          Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollPeriod         PayrollPeriod                 @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)

  @@unique([payrollPeriodId, employeeId])
  @@index([organizationId])
  @@index([organizationId, payrollPeriodId])
  @@index([organizationId, employeeId])
  @@index([status])
}

model TaxObligation {
  id                 String       @id @default(cuid())
  organizationId     String
  taxType            String
  name               String
  registrationNumber String?
  filingFrequency    String
  dueRule            String?
  currency           String       @default("KES")
  isActive           Boolean      @default(true)
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxReturns         TaxReturn[]

  @@unique([organizationId, taxType])
  @@index([organizationId])
  @@index([organizationId, isActive])
}

model TaxFiling {
  id                String         @id @default(cuid())
  organizationId    String
  taxObligationCode String
  payrollPeriodId   String?
  taxPeriodStart    DateTime
  taxPeriodEnd      DateTime
  dueDate           DateTime
  taxableAmount     Decimal        @default(0) @db.Decimal(14, 2)
  taxAmount         Decimal        @default(0) @db.Decimal(14, 2)
  adjustments       Decimal        @default(0) @db.Decimal(14, 2)
  penalties         Decimal        @default(0) @db.Decimal(14, 2)
  interest          Decimal        @default(0) @db.Decimal(14, 2)
  totalPayable      Decimal        @default(0) @db.Decimal(14, 2)
  filingReference   String?
  filingDate        DateTime?
  filingStatus      String         @default("DRAFT")
  paymentStatus     String         @default("UNPAID")
  preparedBy        String?
  reviewedBy        String?
  approvedBy        String?
  approvedAt        DateTime?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  taxPeriodId       String?
  taxReturnId       String?
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollPeriod     PayrollPeriod? @relation(fields: [payrollPeriodId], references: [id])
  taxPeriod         TaxPeriod?     @relation(fields: [taxPeriodId], references: [id])
  taxReturn         TaxReturn?     @relation(fields: [taxReturnId], references: [id])
  payments          TaxPayment[]

  @@index([organizationId])
  @@index([organizationId, taxObligationCode])
  @@index([organizationId, dueDate])
  @@index([organizationId, filingStatus])
  @@index([organizationId, paymentStatus])
  @@index([organizationId, taxPeriodId])
  @@index([organizationId, taxReturnId])
  @@index([payrollPeriodId])
}

model TaxPayment {
  id               String       @id @default(cuid())
  organizationId   String
  taxFilingId      String
  paymentReference String?
  paymentDate      DateTime
  amount           Decimal      @db.Decimal(14, 2)
  paymentMethod    String
  status           String       @default("COMPLETED")
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  filing           TaxFiling    @relation(fields: [taxFilingId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, taxFilingId])
  @@index([paymentDate])
  @@index([status])
}

/// Tax regime is the top-level tenant-specific tax framework.
/// Examples include VAT, withholding tax, PAYE and other statutory regimes.
model TaxRegime {
  id                 String       @id @default(cuid())
  organizationId     String
  code               String
  name               String
  taxType            String
  countryCode        String       @default("KE")
  currency           String       @default("KES")
  description        String?
  registrationNumber String?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  taxCodes           TaxCode[]
  taxPeriods         TaxPeriod[]
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxReturns         TaxReturn[]
  taxRules           TaxRule[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, taxType])
  @@index([organizationId, isActive])
}

/// Tax code represents the tax treatment selected on a transaction.
/// Rates are effective-dated and are never hard-coded in transaction modules.
model TaxCode {
  id                  String               @id @default(cuid())
  organizationId      String
  taxRegimeId         String
  code                String
  name                String
  description         String?
  direction           String               @default("OUTPUT")
  treatment           String               @default("STANDARD")
  calculationMethod   String               @default("PERCENTAGE")
  defaultRate         Decimal              @default(0) @db.Decimal(9, 6)
  isInclusive         Boolean              @default(false)
  isRecoverable       Boolean              @default(false)
  recoverabilityRate  Decimal              @default(0) @db.Decimal(9, 6)
  isWithholding       Boolean              @default(false)
  isReverseCharge     Boolean              @default(false)
  isExempt            Boolean              @default(false)
  isZeroRated         Boolean              @default(false)
  isActive            Boolean              @default(true)
  metadata            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  accountMappings     TaxAccountMapping[]
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxRegime           TaxRegime            @relation(fields: [taxRegimeId], references: [id])
  taxRates            TaxRate[]
  taxRules            TaxRule[]
  taxTransactions     TaxTransaction[]
  taxTransactionLines TaxTransactionLine[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, taxRegimeId])
  @@index([organizationId, direction])
  @@index([organizationId, isActive])
}

/// Effective-dated tax rate. Multiple historical rates are allowed.
model TaxRate {
  id              String           @id @default(cuid())
  organizationId  String
  taxCodeId       String
  name            String
  rate            Decimal          @db.Decimal(9, 6)
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  roundingScale   Int              @default(2)
  roundingMode    String           @default("HALF_UP")
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxCode         TaxCode          @relation(fields: [taxCodeId], references: [id], onDelete: Cascade)
  taxTransactions TaxTransaction[]

  @@index([organizationId])
  @@index([organizationId, taxCodeId])
  @@index([organizationId, effectiveFrom, effectiveTo])
  @@index([organizationId, isActive])
}

/// Rule used by the tax determination engine.
/// Conditions are stored as structured JSON so new statutory rules can be added
/// without changing the database schema for every jurisdictional variation.
model TaxRule {
  id              String           @id @default(cuid())
  organizationId  String
  taxRegimeId     String
  taxCodeId       String?
  code            String
  name            String
  priority        Int              @default(100)
  transactionType String?
  customerType    String?
  vendorType      String?
  supplyType      String?
  jurisdiction    String?
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  conditions      Json?
  actions         Json?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxCode         TaxCode?         @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  taxRegime       TaxRegime        @relation(fields: [taxRegimeId], references: [id])
  taxTransactions TaxTransaction[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, taxRegimeId])
  @@index([organizationId, taxCodeId])
  @@index([organizationId, effectiveFrom, effectiveTo])
  @@index([organizationId, priority])
  @@index([organizationId, isActive])
}

/// Maps a tax code to the GL accounts required for posting.
/// INPUT, OUTPUT, WITHHOLDING and adjustment mappings are tenant-specific.
model TaxAccountMapping {
  id             String       @id @default(cuid())
  organizationId String
  taxCodeId      String
  accountId      String
  mappingType    String
  isDefault      Boolean      @default(true)
  effectiveFrom  DateTime     @default(now())
  effectiveTo    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  account        Account      @relation("TaxAccountMappingAccount", fields: [accountId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxCode        TaxCode      @relation(fields: [taxCodeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, taxCodeId, mappingType, accountId])
  @@index([organizationId])
  @@index([organizationId, taxCodeId])
  @@index([organizationId, accountId])
  @@index([organizationId, mappingType])
  @@index([organizationId, effectiveFrom, effectiveTo])
}

/// Accounting tax event generated from an invoice, expense, supplier bill,
/// payroll transaction or adjustment. Every row belongs to exactly one tenant.
model TaxTransaction {
  id                   String               @id @default(cuid())
  organizationId       String
  taxCodeId            String
  taxRateId            String?
  taxRuleId            String?
  taxPeriodId          String?
  sourceType           String
  sourceId             String
  sourceLineId         String?
  transactionDate      DateTime
  postingDate          DateTime?
  currency             String               @default("KES")
  exchangeRate         Decimal              @default(1) @db.Decimal(18, 8)
  taxableAmount        Decimal              @default(0) @db.Decimal(18, 2)
  taxAmount            Decimal              @default(0) @db.Decimal(18, 2)
  recoverableAmount    Decimal              @default(0) @db.Decimal(18, 2)
  nonRecoverableAmount Decimal              @default(0) @db.Decimal(18, 2)
  taxBaseAmount        Decimal              @default(0) @db.Decimal(18, 2)
  direction            String               @default("OUTPUT")
  calculationMethod    String               @default("PERCENTAGE")
  rateApplied          Decimal              @default(0) @db.Decimal(9, 6)
  isInclusive          Boolean              @default(false)
  isReverseCharge      Boolean              @default(false)
  status               String               @default("CALCULATED")
  idempotencyKey       String?
  description          String?
  metadata             Json?
  createdBy            String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxCode              TaxCode              @relation(fields: [taxCodeId], references: [id])
  taxPeriod            TaxPeriod?           @relation(fields: [taxPeriodId], references: [id], onDelete: Restrict)
  taxRate              TaxRate?             @relation(fields: [taxRateId], references: [id], onDelete: Restrict)
  taxRule              TaxRule?             @relation(fields: [taxRuleId], references: [id], onDelete: Restrict)
  lines                TaxTransactionLine[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([organizationId, taxCodeId])
  @@index([organizationId, taxPeriodId])
  @@index([organizationId, transactionDate])
  @@index([organizationId, sourceType, sourceId])
  @@index([organizationId, status])
  @@index([organizationId, direction])
}

/// Individual tax component of a tax transaction.
/// A transaction may contain multiple tax lines for compound or withholding taxes.
model TaxTransactionLine {
  id                   String         @id @default(cuid())
  organizationId       String
  taxTransactionId     String
  taxCodeId            String
  lineNumber           Int
  taxableAmount        Decimal        @default(0) @db.Decimal(18, 2)
  taxAmount            Decimal        @default(0) @db.Decimal(18, 2)
  recoverableAmount    Decimal        @default(0) @db.Decimal(18, 2)
  nonRecoverableAmount Decimal        @default(0) @db.Decimal(18, 2)
  rateApplied          Decimal        @default(0) @db.Decimal(9, 6)
  accountId            String?
  description          String?
  metadata             Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  account              Account?       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxCode              TaxCode        @relation(fields: [taxCodeId], references: [id])
  taxTransaction       TaxTransaction @relation(fields: [taxTransactionId], references: [id], onDelete: Cascade)

  @@unique([taxTransactionId, lineNumber])
  @@index([organizationId])
  @@index([organizationId, taxTransactionId])
  @@index([organizationId, taxCodeId])
  @@index([organizationId, accountId])
}

/// Tax accounting period. Transactions are assigned to a period and periods
/// can be closed to prevent silent post-close changes.
model TaxPeriod {
  id              String           @id @default(cuid())
  organizationId  String
  taxRegimeId     String
  code            String
  name            String
  periodStart     DateTime
  periodEnd       DateTime
  filingDueDate   DateTime?
  status          String           @default("OPEN")
  currency        String           @default("KES")
  closedAt        DateTime?
  closedBy        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  taxFilings      TaxFiling[]
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxRegime       TaxRegime        @relation(fields: [taxRegimeId], references: [id])
  taxReturns      TaxReturn[]
  taxTransactions TaxTransaction[]

  @@unique([organizationId, taxRegimeId, code])
  @@unique([organizationId, taxRegimeId, periodStart, periodEnd])
  @@index([organizationId])
  @@index([organizationId, taxRegimeId])
  @@index([organizationId, periodStart, periodEnd])
  @@index([organizationId, status])
  @@index([organizationId, filingDueDate])
}

/// Tax return is the calculated statutory position for a tax period.
/// TaxFiling remains the compatibility/submission record used by the existing UI.
model TaxReturn {
  id              String         @id @default(cuid())
  organizationId  String
  taxRegimeId     String
  taxPeriodId     String
  taxObligationId String?
  returnType      String
  status          String         @default("DRAFT")
  taxableAmount   Decimal        @default(0) @db.Decimal(18, 2)
  outputTax       Decimal        @default(0) @db.Decimal(18, 2)
  inputTax        Decimal        @default(0) @db.Decimal(18, 2)
  withholdingTax  Decimal        @default(0) @db.Decimal(18, 2)
  adjustments     Decimal        @default(0) @db.Decimal(18, 2)
  penalties       Decimal        @default(0) @db.Decimal(18, 2)
  interest        Decimal        @default(0) @db.Decimal(18, 2)
  netTaxPayable   Decimal        @default(0) @db.Decimal(18, 2)
  filingReference String?
  filedAt         DateTime?
  preparedBy      String?
  reviewedBy      String?
  approvedBy      String?
  approvedAt      DateTime?
  notes           String?
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  filings         TaxFiling[]
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxObligation   TaxObligation? @relation(fields: [taxObligationId], references: [id], onDelete: Restrict)
  taxPeriod       TaxPeriod      @relation(fields: [taxPeriodId], references: [id])
  taxRegime       TaxRegime      @relation(fields: [taxRegimeId], references: [id])

  @@unique([organizationId, taxPeriodId, returnType])
  @@index([organizationId])
  @@index([organizationId, taxRegimeId])
  @@index([organizationId, taxPeriodId])
  @@index([organizationId, status])
  @@index([organizationId, filingReference])
}

model SupportTicket {
  id             String       @id @default(cuid())
  ticketNumber   String       @unique
  organizationId String
  subject        String
  description    String
  priority       String       @default("MEDIUM")
  status         String       @default("OPEN")
  category       String       @default("GENERAL")
  adminNotes     String?
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model FraudAlert {
  id             String       @id @default(cuid())
  alertCode      String
  type           String
  description    String
  severity       String
  status         String       @default("OPEN")
  riskScore      Float
  sourceType     String
  sourceId       String?
  amount         Float?
  detectedAt     DateTime     @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?
  notes          String?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, alertCode])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, severity])
  @@index([organizationId, detectedAt])
  @@index([organizationId, sourceType])
  @@index([organizationId, sourceId])
}

model ProcurementRequest {
  id              String           @id @default(cuid())
  requestCode     String
  item            String
  department      String
  quantity        Int
  estimatedAmount Float
  notes           String?
  status          String           @default("PENDING")
  requestedBy     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organizationId  String
  vendorId        String?
  approvalId      String?          @unique
  budgetId        String?
  accountsPayable AccountsPayable?
  asset           Asset?
  expense         Expense?
  approval        Approval?        @relation(fields: [approvalId], references: [id])
  budget          Budget?          @relation(fields: [budgetId], references: [id])
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor          Vendor?          @relation(fields: [vendorId], references: [id])

  @@unique([organizationId, requestCode])
  @@index([vendorId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, department])
  @@index([approvalId])
  @@index([budgetId])
}

model JournalEntryLine {
  id             String       @id @default(cuid())
  journalEntryId String
  accountId      String
  lineNumber     Int
  memo           String?
  debit          Float        @default(0)
  credit         Float        @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  account        Account      @relation(fields: [accountId], references: [id])
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@unique([journalEntryId, lineNumber])
  @@index([journalEntryId])
  @@index([accountId])
}

/// *
/// * Versioned FOS-wide configuration template.
/// *
/// * This stores configuration snapshots only. It must never be used
/// * as a generic tenant/business-data copy mechanism.
model TenantTemplate {
  id                   String       @id @default(cuid())
  templateKey          String
  sourceOrganizationId String
  version              Int
  schemaVersion        Int
  snapshot             Json
  publishedByUserId    String?
  publishedAt          DateTime     @default(now())
  createdAt            DateTime     @default(now())
  sourceOrganization   Organization @relation("TenantTemplateSource", fields: [sourceOrganizationId], references: [id], onDelete: Cascade)

  @@unique([sourceOrganizationId, version])
  @@index([sourceOrganizationId])
  @@index([templateKey])
  @@index([templateKey, version])
  @@index([publishedAt])
}

/// *
/// * Records the latest FOS template successfully reconciled against
/// * a tenant and retains the previous configuration snapshot needed
/// * for safe three-way reconciliation.
model TenantTemplateApplication {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  templateVersion Int
  snapshot        Json
  appliedAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([templateVersion])
  @@index([appliedAt])
}
