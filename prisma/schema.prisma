generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                      String                        @id @default(cuid())
  name                    String
  slug                    String                        @unique
  legalName               String?
  registrationNumber      String?
  taxNumber               String?
  email                   String?
  phoneNumber             String?
  address                 String?
  country                 String                        @default("Kenya")
  currency                String                        @default("KES")
  logoUrl                 String?
  status                  String                        @default("ACTIVE")
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  accounts                Account[]
  accountsPayable         AccountsPayable[]
  accountsReceivable      AccountsReceivable[]
  approvals               Approval[]
  assets                  Asset[]
  assetAssignments        AssetAssignment[]
  auditTrails             AuditTrail[]
  bankAccounts            BankAccount[]
  bankPayments            BankPayment[]
  bankPaymentBatches      BankPaymentBatch[]
  budgets                 Budget[]
  customers               Customer[]
  documents               Document[]
  employees               Employee[]
  employeePayrollProfiles EmployeePayrollProfile[]
  employeeLoans           EmployeeLoan[]
  salaryAdvances          SalaryAdvance[]
  payrollDeductions       PayrollDeduction[]
  payrollContributions    PayrollEmployerContribution[]
  expenses                Expense[]
  fraudAlerts             FraudAlert[]
  investments             Investment[]
  invoices                Invoice[]
  journalEntries          JournalEntry[]
  loans                   Loan[]
  mpesaAccounts           MpesaAccount[]
  mpesaPaymentBatches     MpesaPaymentBatch[]
  mpesaTransactions       MpesaTransaction[]
  invitations             OrganizationInvitation[]
  memberships             OrganizationMember[]
  payrollPeriods          PayrollPeriod[]
  payrollRecords          PayrollRecord[]
  portfolioCompanies      PortfolioCompany[]
  procurementRequests     ProcurementRequest[]
  subscription            Subscription?
  supportTickets          SupportTicket[]
  taxFilings              TaxFiling[]
  taxObligations          TaxObligation[]
  taxPayments             TaxPayment[]
  transactions            Transaction[]
  vendors                 Vendor[]

  @@index([status])
}

model Document {
  id             String       @id @default(cuid())
  documentCode   String
  name           String
  category       String
  uploadedBy     String
  mimeType       String?
  fileSize       Int?
  storageKey     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, documentCode])
  @@index([organizationId])
  @@index([organizationId, category])
  @@index([organizationId, createdAt])
}

model Subscription {
  id             String       @id @default(cuid())
  organizationId String       @unique
  plan           String       @default("STARTER")
  status         String       @default("TRIAL")
  billingCycle   String       @default("MONTHLY")
  amount         Float        @default(0)
  currency       String       @default("KES")
  startDate      DateTime     @default(now())
  endDate        DateTime?
  trialEndsAt    DateTime?
  cancelledAt    DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([plan])
}

model User {
  id              String               @id @default(cuid())
  name            String
  email           String               @unique
  password        String
  role            String
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  phoneNumber     String?
  platformRole    String?
  phoneVerifiedAt DateTime?
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  lastLoginIp     String?
  lockedUntil     DateTime?
  loginAttempts   Int                  @default(0)
  memberships     OrganizationMember[]
  sessions        Session[]

  @@index([phoneNumber])
  @@index([platformRole])
  @@index([isActive])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  ipAddress    String?
  userAgent    String?
  isActive     Boolean  @default(true)
  rememberMe   Boolean  @default(false)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([isActive])
}

model OtpVerification {
  id            String    @id @default(cuid())
  email         String?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  phoneNumber   String?
  userId        String?
  code          String
  verifiedAt    DateTime?
  attempts      Int       @default(0)
  isInvalidated Boolean   @default(false)
  type          String    @default("LOGIN")

  @@index([userId])
  @@index([email])
  @@index([phoneNumber])
  @@index([expiresAt])
  @@index([type])
  @@index([isInvalidated])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String
  isActive       Boolean      @default(true)
  isDefault      Boolean      @default(false)
  joinedAt       DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  permissions    String[]     @default([])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model OrganizationInvitation {
  id              String       @id @default(cuid())
  organizationId  String
  email           String
  role            String
  permissions     String[]     @default([])
  tokenHash       String       @unique
  status          String       @default("PENDING")
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@index([invitedByUserId])
}

model PlatformAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actorEmail  String
  action      String
  resource    String
  resourceId  String?
  details     String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([resource])
  @@index([resourceId])
  @@index([createdAt])
}

model Account {
  id              String             @id @default(cuid())
  code            String
  name            String
  type            String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  description     String?
  parentId        String?
  organizationId  String
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent          Account?           @relation("AccountHierarchy", fields: [parentId], references: [id])
  children        Account[]          @relation("AccountHierarchy")
  journalLines    JournalEntryLine[]
  creditEntries   JournalEntry[]     @relation("CreditEntries")
  debitEntries    JournalEntry[]     @relation("DebitEntries")
  expenseAccounts Expense[]          @relation("ExpenseAccount")
  paymentExpenses Expense[]          @relation("ExpensePaymentAccount")

  @@unique([organizationId, code])
  @@index([organizationId])
}

model JournalEntry {
  id              String             @id @default(cuid())
  reference       String
  description     String
  debitAccountId  String
  creditAccountId String
  amount          Float
  createdAt       DateTime           @default(now())
  approvedAt      DateTime?
  approvedBy      String?
  createdBy       String?
  notes           String?
  postedAt        DateTime?
  postedBy        String?
  reversalOfId    String?            @unique
  reversalReason  String?
  reversedAt      DateTime?
  reversedBy      String?
  status          String             @default("DRAFT")
  transactionDate DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  organizationId  String
  creditAccount   Account            @relation("CreditEntries", fields: [creditAccountId], references: [id])
  debitAccount    Account            @relation("DebitEntries", fields: [debitAccountId], references: [id])
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reversalOf      JournalEntry?      @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals       JournalEntry?      @relation("JournalReversal")
  lines           JournalEntryLine[]
  expense         Expense?

  @@unique([organizationId, reference])
  @@index([organizationId])
  @@index([debitAccountId])
  @@index([creditAccountId])
  @@index([status])
  @@index([transactionDate])
}

model Customer {
  id             String       @id @default(cuid())
  firstName      String
  lastName       String
  phoneNumber    String
  email          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  loans          Loan[]

  @@unique([organizationId, phoneNumber])
  @@index([organizationId])
}

model Loan {
  id             String       @id @default(cuid())
  customerId     String
  amount         Float
  balance        Float
  status         String
  issuedAt       DateTime     @default(now())
  dueDate        DateTime
  organizationId String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([customerId])
}

model Transaction {
  id             String       @id @default(cuid())
  reference      String
  description    String
  amount         Float
  type           String
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, reference])
  @@index([organizationId])
}

model Budget {
  id             String       @id @default(cuid())
  department     String
  amount         Float
  year           Int
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Asset {
  id             String            @id @default(cuid())
  assetCode      String
  name           String
  category       String
  value          Float
  status         String
  createdAt      DateTime          @default(now())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments    AssetAssignment[]

  @@unique([organizationId, assetCode])
  @@index([organizationId])
}

model AssetAssignment {
  id                    String       @id @default(cuid())
  assetId               String
  employeeId            String
  organizationId        String
  assignedAt            DateTime     @default(now())
  returnedAt            DateTime?
  conditionAtAssignment String?
  conditionAtReturn     String?
  notes                 String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  asset                 Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee              Employee     @relation(fields: [employeeId], references: [id])
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, employeeId])
  @@index([organizationId, assetId])
  @@index([assetId, returnedAt])
}

model AuditTrail {
  id             String       @id @default(cuid())
  user           String
  action         String
  module         String
  details        String
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Approval {
  id             String       @id @default(cuid())
  module         String
  description    String
  amount         Float
  requestedBy    String
  status         String
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expense        Expense?

  @@index([organizationId])
}

model Vendor {
  id             String            @id @default(cuid())
  vendorCode     String
  name           String
  email          String?
  phoneNumber    String?
  address        String?
  taxNumber      String?
  status         String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organizationId String
  payables       AccountsPayable[]
  expenses       Expense[]
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, vendorCode])
  @@index([organizationId])
}

model AccountsPayable {
  id                 String       @id @default(cuid())
  invoiceNumber      String
  description        String
  amount             Float
  outstandingBalance Float
  dueDate            DateTime
  paymentStatus      String
  status             String
  approvedBy         String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  vendorId           String
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor             Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([vendorId])
}

model AccountsReceivable {
  id                 String       @id @default(cuid())
  invoiceNumber      String
  customerName       String
  description        String
  amount             Float
  outstandingBalance Float
  dueDate            DateTime
  paymentStatus      String
  status             String
  approvedBy         String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
}

model Expense {
  id          String  @id @default(cuid())
  expenseCode String
  vendorId    String?

  category    String
  description String
  amount      Float
  currency    String   @default("KES")
  expenseDate DateTime

  status String @default("PENDING")

  paymentStatus    String    @default("UNPAID")
  paymentMethod    String?
  paymentDate      DateTime?
  paymentReference String?

  approvedBy String?

  expenseAccountId String?
  paymentAccountId String?
  bankAccountId    String?

  approvalId     String? @unique
  journalEntryId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor       Vendor?      @relation(fields: [vendorId], references: [id])

  expenseAccount Account?      @relation("ExpenseAccount", fields: [expenseAccountId], references: [id])
  paymentAccount Account?      @relation("ExpensePaymentAccount", fields: [paymentAccountId], references: [id])
  bankAccount    BankAccount?  @relation(fields: [bankAccountId], references: [id])
  approval       Approval?     @relation(fields: [approvalId], references: [id])
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@unique([organizationId, expenseCode])
  @@index([organizationId])
  @@index([vendorId])
  @@index([expenseAccountId])
  @@index([paymentAccountId])
  @@index([bankAccountId])
  @@index([status])
  @@index([paymentStatus])
  @@index([expenseDate])
}

model BankAccount {
  id                  String             @id @default(cuid())
  bankName            String
  accountName         String
  accountNumber       String
  branchName          String?
  currency            String             @default("KES")
  openingBalance      Float              @default(0)
  currentBalance      Float              @default(0)
  integrationEnabled  Boolean            @default(false)
  integrationProvider String?
  apiBaseUrl          String?
  apiKey              String?
  apiSecret           String?
  webhookUrl          String?
  connectionStatus    String             @default("DISCONNECTED")
  lastSyncAt          DateTime?
  status              String             @default("ACTIVE")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  organizationId      String
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankPayments        BankPayment[]
  bankPaymentBatches  BankPaymentBatch[]
  expenses            Expense[]

  @@unique([organizationId, accountNumber])
  @@index([organizationId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model BankPayment {
  id                String            @id
  organizationId    String
  bankAccountId     String
  batchId           String?
  paymentReference  String
  beneficiaryName   String
  accountNumber     String?
  bankCode          String?
  branchCode        String?
  amount            Decimal           @db.Decimal(18, 2)
  currency          String            @default("KES")
  description       String?
  status            String            @default("PENDING")
  provider          String?
  providerPaymentId String?
  providerStatus    String?
  failureReason     String?
  idempotencyKey    String?
  submittedAt       DateTime?         @db.Timestamptz(6)
  completedAt       DateTime?         @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @db.Timestamptz(6)
  accountReference  String?
  paybillNumber     String?
  paymentType       String            @default("BANK_TRANSFER")
  tillNumber        String?
  BankAccount       BankAccount       @relation(fields: [bankAccountId], references: [id], onUpdate: NoAction)
  BankPaymentBatch  BankPaymentBatch? @relation(fields: [batchId], references: [id], onUpdate: NoAction)
  Organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organizationId, paymentReference], map: "BankPayment_org_reference_key")
  @@index([batchId], map: "BankPayment_batch_idx")
  @@index([createdAt], map: "BankPayment_created_idx")
  @@index([organizationId, bankAccountId], map: "BankPayment_org_bank_idx")
  @@index([organizationId], map: "BankPayment_org_idx")
  @@index([organizationId, status], map: "BankPayment_org_status_idx")
  @@index([providerPaymentId], map: "BankPayment_provider_idx")
}

model BankPaymentBatch {
  id              String        @id
  organizationId  String
  bankAccountId   String
  batchReference  String
  description     String?
  totalAmount     Decimal       @default(0) @db.Decimal(18, 2)
  totalPayments   Int           @default(0)
  successful      Int           @default(0)
  failed          Int           @default(0)
  pending         Int           @default(0)
  status          String        @default("PENDING")
  provider        String?
  providerBatchId String?
  idempotencyKey  String?
  submittedAt     DateTime?     @db.Timestamptz(6)
  completedAt     DateTime?     @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @db.Timestamptz(6)
  BankPayment     BankPayment[]
  BankAccount     BankAccount   @relation(fields: [bankAccountId], references: [id], onUpdate: NoAction)
  Organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organizationId, batchReference], map: "BankPaymentBatch_org_reference_key")
  @@index([createdAt], map: "BankPaymentBatch_created_idx")
  @@index([organizationId, bankAccountId], map: "BankPaymentBatch_org_bank_idx")
  @@index([organizationId], map: "BankPaymentBatch_org_idx")
  @@index([organizationId, status], map: "BankPaymentBatch_org_status_idx")
  @@index([providerBatchId], map: "BankPaymentBatch_provider_batch_idx")
}

model Invoice {
  id             String       @id @default(cuid())
  invoiceNumber  String
  customerName   String
  customerEmail  String?
  customerPhone  String?
  description    String
  subtotal       Float
  taxAmount      Float        @default(0)
  totalAmount    Float
  issueDate      DateTime
  dueDate        DateTime
  paymentStatus  String       @default("UNPAID")
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
}

model MpesaAccount {
  id                          String             @id @default(cuid())
  organizationId              String
  name                        String
  accountType                 String             @default("PAYBILL")
  shortcode                   String
  environment                 String             @default("sandbox")
  consumerKeyEncrypted        String
  consumerSecretEncrypted     String
  initiatorName               String
  securityCredentialEncrypted String
  stkPasskeyEncrypted         String?
  resultUrl                   String
  timeoutUrl                  String
  isActive                    Boolean            @default(false)
  isDefault                   Boolean            @default(false)
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  organization                Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions                MpesaTransaction[]

  @@unique([organizationId, name])
  @@unique([organizationId, shortcode])
  @@index([organizationId])
  @@index([organizationId, isActive])
}

model MpesaTransaction {
  id                       String             @id @default(cuid())
  transactionType          String
  organizationId           String
  merchantRequestId        String?
  checkoutRequestId        String?
  phoneNumber              String?
  amount                   Float
  mpesaReceiptNumber       String?
  transactionDate          DateTime?
  resultCode               Int?
  resultDescription        String?
  accountReference         String?
  transactionDesc          String?
  counterparty             String?
  status                   String             @default("PENDING")
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  batchId                  String?
  conversationId           String?
  originatorConversationId String?
  mpesaAccountId           String?
  destination              String?
  destinationName          String?
  destinationType          String?
  paybillNumber            String?
  paymentMethod            String?
  tillNumber               String?
  batch                    MpesaPaymentBatch? @relation(fields: [batchId], references: [id])
  mpesaAccount             MpesaAccount?      @relation(fields: [mpesaAccountId], references: [id])
  organization             Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, batchId])
  @@index([organizationId, mpesaAccountId])
  @@index([mpesaReceiptNumber])
  @@index([conversationId])
  @@index([originatorConversationId])
  @@index([status])
  @@index([organizationId, destinationType])
  @@index([organizationId, paymentMethod])
}

model MpesaPaymentBatch {
  id             String             @id @default(cuid())
  organizationId String
  batchReference String
  description    String?
  totalAmount    Float              @default(0)
  totalPayments  Int                @default(0)
  successful     Int                @default(0)
  failed         Int                @default(0)
  pending        Int                @default(0)
  status         String             @default("PENDING")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions   MpesaTransaction[]

  @@unique([organizationId, batchReference])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([createdAt])
}

model PortfolioCompany {
  id                  String       @id @default(cuid())
  companyCode         String
  companyName         String
  registrationNumber  String?
  kraPin              String?
  industry            String?
  businessType        String?
  contactPerson       String?
  phoneNumber         String?
  email               String?
  address             String?
  investmentType      String?
  investmentAmount    Float        @default(0)
  ownershipPercentage Float?
  expectedReturn      Float?
  investmentDate      DateTime?
  currentValuation    Float?
  currentRevenue      Float?
  currentExpenses     Float?
  currentProfit       Float?
  repaymentStatus     String?
  riskRating          String?
  status              String       @default("ACTIVE")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organizationId      String
  investments         Investment[]
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, companyCode])
  @@index([organizationId])
}

model Investment {
  id                  String           @id @default(cuid())
  investmentCode      String
  portfolioCompanyId  String
  investmentType      String
  fundingRound        String?
  amount              Float
  ownershipPercentage Float?
  valuationBefore     Float?
  valuationAfter      Float?
  expectedReturn      Float?
  investmentDate      DateTime
  maturityDate        DateTime?
  status              String           @default("ACTIVE")
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  organizationId      String
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  portfolioCompany    PortfolioCompany @relation(fields: [portfolioCompanyId], references: [id], onDelete: Cascade)

  @@unique([organizationId, investmentCode])
  @@index([organizationId])
  @@index([portfolioCompanyId])
}

model Employee {
  id               String                  @id @default(cuid())
  employeeNumber   String
  firstName        String
  lastName         String
  email            String?
  phoneNumber      String?
  department       String?
  jobTitle         String?
  employmentType   String                  @default("FULL_TIME")
  hireDate         DateTime
  basicSalary      Decimal                 @db.Decimal(14, 2)
  status           String                  @default("ACTIVE")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  organizationId   String
  assetAssignments AssetAssignment[]
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollRecords   PayrollRecord[]
  payrollProfile   EmployeePayrollProfile?
  employeeLoans    EmployeeLoan[]
  salaryAdvances   SalaryAdvance[]

  @@unique([organizationId, employeeNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, department])
  @@index([organizationId, email])
}

model EmployeePayrollProfile {
  id                   String       @id @default(cuid())
  employeeId           String       @unique
  organizationId       String
  kraPin               String?
  nssfNumber           String?
  shaNumber            String?
  helbNumber           String?
  payeEnabled          Boolean      @default(true)
  nssfEnabled          Boolean      @default(true)
  shaEnabled           Boolean      @default(true)
  housingLevyEnabled   Boolean      @default(true)
  pensionEnabled       Boolean      @default(false)
  pensionRate          Decimal      @default(0) @db.Decimal(5, 2)
  pensionAmount        Decimal      @default(0) @db.Decimal(14, 2)
  helbEnabled          Boolean      @default(false)
  helbAmount           Decimal      @default(0) @db.Decimal(14, 2)
  otherDeductionAmount Decimal      @default(0) @db.Decimal(14, 2)
  otherDeductionNotes  String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  employee             Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model EmployeeLoan {
  id                 String       @id @default(cuid())
  employeeId         String
  organizationId     String
  reference          String
  description        String?
  principalAmount    Decimal      @db.Decimal(14, 2)
  outstandingBalance Decimal      @db.Decimal(14, 2)
  monthlyRepayment   Decimal      @db.Decimal(14, 2)
  startDate          DateTime
  endDate            DateTime?
  status             String       @default("ACTIVE")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  employee           Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, reference])
  @@index([organizationId])
  @@index([organizationId, employeeId])
  @@index([organizationId, status])
}

model SalaryAdvance {
  id                 String       @id @default(cuid())
  employeeId         String
  organizationId     String
  reference          String
  amount             Decimal      @db.Decimal(14, 2)
  outstandingBalance Decimal      @db.Decimal(14, 2)
  monthlyRepayment   Decimal      @db.Decimal(14, 2)
  issuedDate         DateTime     @default(now())
  status             String       @default("ACTIVE")
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  employee           Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, reference])
  @@index([organizationId])
  @@index([organizationId, employeeId])
  @@index([organizationId, status])
}

model PayrollDeduction {
  id              String        @id @default(cuid())
  payrollRecordId String
  organizationId  String
  type            String
  description     String?
  amount          Decimal       @db.Decimal(14, 2)
  createdAt       DateTime      @default(now())
  payrollRecord   PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, payrollRecordId])
  @@index([organizationId, type])
}

model PayrollEmployerContribution {
  id              String        @id @default(cuid())
  payrollRecordId String
  organizationId  String
  type            String
  description     String?
  amount          Decimal       @db.Decimal(14, 2)
  createdAt       DateTime      @default(now())
  payrollRecord   PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, payrollRecordId])
  @@index([organizationId, type])
}

model PayrollPeriod {
  id              String          @id @default(cuid())
  name            String
  periodStart     DateTime
  periodEnd       DateTime
  status          String          @default("DRAFT")
  totalGross      Decimal         @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal         @default(0) @db.Decimal(14, 2)
  totalNet        Decimal         @default(0) @db.Decimal(14, 2)
  processedAt     DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  paidAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollRecords  PayrollRecord[]
  taxFilings      TaxFiling[]

  @@unique([organizationId, periodStart, periodEnd])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([periodStart, periodEnd])
}

model PayrollRecord {
  id                    String                        @id @default(cuid())
  payrollPeriodId       String
  employeeId            String
  organizationId        String
  basicSalary           Decimal                       @db.Decimal(14, 2)
  allowances            Decimal                       @default(0) @db.Decimal(14, 2)
  grossSalary           Decimal                       @default(0) @db.Decimal(14, 2)
  deductions            Decimal                       @default(0) @db.Decimal(14, 2)
  netSalary             Decimal                       @default(0) @db.Decimal(14, 2)
  status                String                        @default("PENDING")
  processedAt           DateTime?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  employee              Employee                      @relation(fields: [employeeId], references: [id])
  organization          Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollPeriod         PayrollPeriod                 @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  payrollDeductions     PayrollDeduction[]
  employerContributions PayrollEmployerContribution[]

  @@unique([payrollPeriodId, employeeId])
  @@index([organizationId])
  @@index([organizationId, payrollPeriodId])
  @@index([organizationId, employeeId])
  @@index([status])
}

model TaxObligation {
  id                 String       @id @default(cuid())
  organizationId     String
  taxType            String
  name               String
  registrationNumber String?
  filingFrequency    String
  dueRule            String?
  currency           String       @default("KES")
  isActive           Boolean      @default(true)
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, taxType])
  @@index([organizationId])
  @@index([organizationId, isActive])
}

model TaxFiling {
  id                String         @id @default(cuid())
  organizationId    String
  taxObligationCode String
  payrollPeriodId   String?
  taxPeriodStart    DateTime
  taxPeriodEnd      DateTime
  dueDate           DateTime
  taxableAmount     Decimal        @default(0) @db.Decimal(14, 2)
  taxAmount         Decimal        @default(0) @db.Decimal(14, 2)
  adjustments       Decimal        @default(0) @db.Decimal(14, 2)
  penalties         Decimal        @default(0) @db.Decimal(14, 2)
  interest          Decimal        @default(0) @db.Decimal(14, 2)
  totalPayable      Decimal        @default(0) @db.Decimal(14, 2)
  filingReference   String?
  filingDate        DateTime?
  filingStatus      String         @default("DRAFT")
  paymentStatus     String         @default("UNPAID")
  preparedBy        String?
  reviewedBy        String?
  approvedBy        String?
  approvedAt        DateTime?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollPeriod     PayrollPeriod? @relation(fields: [payrollPeriodId], references: [id])
  payments          TaxPayment[]

  @@index([organizationId])
  @@index([organizationId, taxObligationCode])
  @@index([organizationId, dueDate])
  @@index([organizationId, filingStatus])
  @@index([organizationId, paymentStatus])
  @@index([payrollPeriodId])
}

model TaxPayment {
  id               String       @id @default(cuid())
  organizationId   String
  taxFilingId      String
  paymentReference String?
  paymentDate      DateTime
  amount           Decimal      @db.Decimal(14, 2)
  paymentMethod    String
  status           String       @default("COMPLETED")
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  filing           TaxFiling    @relation(fields: [taxFilingId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, taxFilingId])
  @@index([paymentDate])
  @@index([status])
}

model SupportTicket {
  id             String       @id @default(cuid())
  ticketNumber   String       @unique
  organizationId String
  subject        String
  description    String
  priority       String       @default("MEDIUM")
  status         String       @default("OPEN")
  category       String       @default("GENERAL")
  adminNotes     String?
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model FraudAlert {
  id             String       @id @default(cuid())
  alertCode      String
  type           String
  description    String
  severity       String
  status         String       @default("OPEN")
  riskScore      Float
  sourceType     String
  sourceId       String?
  amount         Float?
  detectedAt     DateTime     @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?
  notes          String?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, alertCode])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, severity])
  @@index([organizationId, detectedAt])
  @@index([organizationId, sourceType])
  @@index([organizationId, sourceId])
}

model ProcurementRequest {
  id              String       @id @default(cuid())
  requestCode     String
  item            String
  department      String
  quantity        Int
  estimatedAmount Float
  notes           String?
  status          String       @default("PENDING")
  requestedBy     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, requestCode])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, department])
}

model JournalEntryLine {
  id             String   @id @default(cuid())
  journalEntryId String
  accountId      String
  lineNumber     Int
  memo           String?
  debit          Float    @default(0)
  credit         Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@unique([journalEntryId, lineNumber])
  @@index([journalEntryId])
  @@index([accountId])
}
