generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  legalName          String?
  registrationNumber String?
  taxNumber          String?
  email              String?
  phoneNumber        String?
  address            String?
  country            String   @default("Kenya")
  currency           String   @default("KES")
  logoUrl            String?
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  accounts           Account[]
  accountsPayable    AccountsPayable[]
  accountsReceivable AccountsReceivable[]
  approvals          Approval[]
  assets             Asset[]
  auditTrails        AuditTrail[]
  bankAccounts       BankAccount[]
  budgets            Budget[]
  customers          Customer[]
  expenses           Expense[]
  invitations        OrganizationInvitation[]
  invoices           Invoice[]
  investments        Investment[]
  journalEntries     JournalEntry[]
  loans              Loan[]
  memberships        OrganizationMember[]
  mpesaTransactions  MpesaTransaction[]
  portfolioCompanies PortfolioCompany[]
  transactions       Transaction[]
  vendors            Vendor[]

  @@index([status])
}

model User {
  id              String               @id @default(cuid())
  name            String
  email           String               @unique
  password        String
  role            String
  platformRole    String?
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  phoneNumber     String?
  phoneVerifiedAt DateTime?
  memberships     OrganizationMember[]

  @@index([phoneNumber])
  @@index([platformRole])
}

model OrganizationMember {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String
  permissions    String[] @default([])
  isActive       Boolean  @default(true)
  isDefault      Boolean  @default(false)
  joinedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model OrganizationInvitation {
  id              String    @id @default(cuid())
  organizationId  String
  email           String
  role            String
  permissions     String[]  @default([])
  tokenHash       String    @unique
  status          String    @default("PENDING")
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@index([invitedByUserId])
}

model Account {
  id             String   @id @default(cuid())
  code           String
  name           String
  type           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  description    String?
  parentId       String?
  organizationId String

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent        Account?       @relation("AccountHierarchy", fields: [parentId], references: [id])
  children      Account[]      @relation("AccountHierarchy")
  creditEntries JournalEntry[] @relation("CreditEntries")
  debitEntries  JournalEntry[] @relation("DebitEntries")

  @@unique([organizationId, code])
  @@index([organizationId])
}

model JournalEntry {
  id              String    @id @default(cuid())
  reference       String
  description     String
  debitAccountId  String
  creditAccountId String
  amount          Float
  date            DateTime
  status          String
  createdBy       String
  approvedBy      String?
  postedBy        String?
  postedAt        DateTime?
  reversedBy      String?
  reversedAt      DateTime?
  reversalOfId    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  organizationId  String

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  debitAccount  Account        @relation("DebitEntries", fields: [debitAccountId], references: [id])
  creditAccount Account        @relation("CreditEntries", fields: [creditAccountId], references: [id])
  reversalOf    JournalEntry?  @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversals     JournalEntry[] @relation("JournalReversal")

  @@unique([organizationId, reference])
  @@index([organizationId])
  @@index([debitAccountId])
  @@index([creditAccountId])
}

model Customer {
  id             String   @id @default(cuid())
  name           String
  phoneNumber    String
  email          String?
  createdAt      DateTime @default(now())
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  loans        Loan[]

  @@index([organizationId])
}

model Loan {
  id             String   @id @default(cuid())
  customerId     String
  amount         Float
  balance        Float
  status         String
  createdAt      DateTime @default(now())
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([customerId])
}

model Transaction {
  id             String   @id @default(cuid())
  reference      String
  type           String
  amount         Float
  description    String?
  date           DateTime
  createdAt      DateTime @default(now())
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, reference])
  @@index([organizationId])
}

model Budget {
  id             String   @id @default(cuid())
  department     String
  amount         Float
  year           Int
  createdAt      DateTime @default(now())
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Asset {
  id             String   @id @default(cuid())
  assetCode      String
  name           String
  category       String
  value          Float
  status         String
  createdAt      DateTime @default(now())
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, assetCode])
  @@index([organizationId])
}

model AuditTrail {
  id             String   @id @default(cuid())
  user           String
  action         String
  module         String
  details        String
  createdAt      DateTime @default(now())
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model PlatformAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actorEmail  String
  action      String
  resource    String
  resourceId  String?
  details     String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([resource])
  @@index([resourceId])
  @@index([createdAt])
}

model Approval {
  id             String   @id @default(cuid())
  module         String
  description    String
  amount         Float
  requestedBy    String
  status         String
  createdAt      DateTime @default(now())
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Vendor {
  id             String   @id @default(cuid())
  vendorCode     String
  name           String
  email          String?
  phoneNumber    String?
  address        String?
  taxNumber      String?
  status         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organizationId String

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payables     AccountsPayable[]
  expenses     Expense[]

  @@unique([organizationId, vendorCode])
  @@index([organizationId])
}

model AccountsPayable {
  id                 String   @id @default(cuid())
  invoiceNumber      String
  description        String
  amount             Float
  outstandingBalance Float
  dueDate            DateTime
  paymentStatus      String
  status             String
  approvedBy         String?
  vendorId           String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  organizationId     String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([vendorId])
}

model AccountsReceivable {
  id                 String   @id @default(cuid())
  invoiceNumber      String
  customerName       String
  description        String
  amount             Float
  outstandingBalance Float
  dueDate            DateTime
  paymentStatus      String
  status             String
  approvedBy         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  organizationId     String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
}

model Expense {
  id             String   @id @default(cuid())
  description    String
  amount         Float
  category       String
  date           DateTime
  vendorId       String?
  status         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor       Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([vendorId])
}

model BankAccount {
  id             String   @id @default(cuid())
  bankName       String
  accountName    String
  accountNumber  String
  currency       String
  balance        Float
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Invoice {
  id             String    @id @default(cuid())
  invoiceNumber  String
  customerName   String
  amount         Float
  status         String
  dueDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
}

model MpesaTransaction {
  id                 String    @id @default(cuid())
  phoneNumber        String?
  amount             Float
  transactionType    String
  status             String
  mpesaReceiptNumber String?
  merchantRequestId  String?
  checkoutRequestId  String?
  transactionDate    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  organizationId     String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([mpesaReceiptNumber])
}

model PortfolioCompany {
  id                 String   @id @default(cuid())
  organizationId     String
  companyCode        String
  name               String
  legalName          String?
  registrationNumber String?
  taxNumber          String?
  email              String?
  phoneNumber        String?
  address            String?
  country            String?
  industry           String?
  status             String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  investments  Investment[]

  @@unique([organizationId, companyCode])
  @@index([organizationId])
}

model Investment {
  id                 String   @id @default(cuid())
  organizationId     String
  investmentCode     String
  portfolioCompanyId String
  amount             Float
  investmentDate     DateTime
  status             String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  portfolioCompany PortfolioCompany @relation(fields: [portfolioCompanyId], references: [id], onDelete: Cascade)

  @@unique([organizationId, investmentCode])
  @@index([organizationId])
  @@index([portfolioCompanyId])
}

model OtpVerification {
  id          String    @id @default(cuid())
  userId      String?
  email       String?
  phoneNumber String?
  code        String
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([email])
  @@index([phoneNumber])
  @@index([expiresAt])
}
